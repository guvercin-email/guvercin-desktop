{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "guvercin",
  "version": "0.1.0",
  "identifier": "com.guvercin.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "guvercin",
        "width": 1000,
        "height": 700,
        "minWidth": 850,
        "minHeight": 600,
        "resizable": true,
        "devtools": true,
        "fullscreen": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mailto",
          "guvercin"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["eml"],
        "name": "Email Message",
        "description": "Email message file",
        "mimeType": "message/rfc822",
        "role": "Viewer"
      }
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "mail"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3"
        ]
      }
    }
  }
}