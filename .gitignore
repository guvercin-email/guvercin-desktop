# IDEs
.idea/
.vscode/
*.swp
*.swo

# Node / Frontend
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Rust / Backend
target/
**/target/
**/*.rs.bk
# Cargo.lock is tracked on purpose: both crates here are binaries, so the lock
# file is what makes a build reproducible.

# Tauri
src-tauri/target/
src-tauri/gen/
frontend/src-tauri/target/
frontend/src-tauri/gen/

# OS
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db

# Databases / Local Files
*.db
databases/
*.xlsx
.env
.env.*
!.env.example

# Assets — the UI ships SVG icons; Illustrator sources are not kept in the repo.
# The PNGs that do stay (flags, provider marks, the window background) have no
# SVG equivalent, so only the design sources are ignored here.
*.ai

# Licensed fonts (commercial license, not redistributable — see frontend/public/fonts/README.md)
# HankenGrotesk-*.woff2 is the OFL-licensed default and stays tracked.
frontend/public/fonts/*.woff
frontend/public/fonts/*.woff2
frontend/public/fonts/*.ttf
frontend/public/fonts/*.otf
!frontend/public/fonts/HankenGrotesk-*.woff2
